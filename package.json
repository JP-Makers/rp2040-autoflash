{
  "name": "rp2040-autoflash",
  "displayName": "RP2040 Auto Flash",
  "description": "Auto-detect port + UF2, auto-flash RP2040/Pico without pressing BOOTSEL",
  "version": "1.0.3",
  "publisher": "JP-Makers",
  "repository": { "type": "git", "url": "https://gitlab.com/JP-Makers/rp2040-autoflash" },
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["rp2040", "raspberry pi pico", "uf2", "flash", "embedded", "pico", "autoflash"],
  "activationEvents": ["onStartupFinished"],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "rp2040-autoflash.flash",     "title": "RP2040: Auto Flash UF2",                 "icon": "$(zap)" },
      { "command": "rp2040-autoflash.resetOnly", "title": "RP2040: Reset to Bootloader (1200bps)" },
      { "command": "rp2040-autoflash.pickPort",  "title": "RP2040: Select Serial Port" },
      { "command": "rp2040-autoflash.pickUF2",   "title": "RP2040: Select UF2 File" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "rp2040-autoflash.flash", "when": "resourceExtname == .uf2", "group": "rp2040" }
      ]
    },
    "configuration": {
      "title": "RP2040 Auto Flash",
      "properties": {
        "rp2040-autoflash.serialPort": {
          "type": "string", "default": "",
          "description": "Serial port (e.g. COM3, /dev/ttyACM0). Empty = auto-detect."
        },
        "rp2040-autoflash.uf2Path": {
          "type": "string", "default": "",
          "description": "UF2 file path. Empty = auto-detect from workspace."
        },
        "rp2040-autoflash.autoFlashOnBuild": {
          "type": "boolean", "default": false,
          "description": "Automatically flash when a new/updated UF2 file is detected in the workspace (after cmake build)."
        },
        "rp2040-autoflash.bootloaderWaitMs": {
          "type": "number", "default": 3000,
          "description": "Milliseconds to wait for RPI-RP2 drive after reset."
        },
        "rp2040-autoflash.autoDetectDrive": {
          "type": "boolean", "default": true,
          "description": "Auto-detect RPI-RP2 bootloader drive."
        },
        "rp2040-autoflash.drivePath": {
          "type": "string", "default": "",
          "description": "Manual RPI-RP2 drive path (e.g. D:\\ or /media/user/RPI-RP2)."
        }
      }
    }
  },
  "scripts": {
    "package": "npx vsce package --allow-missing-repository"
  },
  "dependencies": {},
  "icon": "icon.png"
}
